# ============================================================================
# AniXOS — Variables d'environnement (exemple)
# ============================================================================
# Copiez ce fichier vers .env.local et remplissez les valeurs.
# .env.local est ignoré par git (voir .gitignore).
# ============================================================================

# --- Supabase (obligatoire) ---
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJxxxxx

# --- Paddle (optionnel — paiement en ligne) ---
# Laissez vide pour désactiver Paddle (le bouton "Choisir ce plan"
# affichera un message d'information au lieu d'ouvrir le Checkout).
VITE_PADDLE_VENDOR_ID=
VITE_PADDLE_ENV=sandbox