{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "AniXOS",
    "version": "1.0.0",
    "identifier": "com.anixos.desktop",
    "build": {
      "beforeDevCommand": "",
      "devUrl": "http://localhost:5173",
      "beforeBuildCommand": "",
      "frontendDist": "../apps/web/dist"
    },
    "app": {
      "windows": [
        {
          "title": "AniXOS",
          "width": 1400,
          "height": 900,
          "minWidth": 1024,
          "minHeight": 600,
          "resizable": true,
          "fullscreen": false,
          "decorations": true,
          "transparent": false,
          "center": true,
          "theme": "Dark"
        }
      ],
      "security": {
        "csp": null
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "icon": [
  "icons/icon.ico",
  "icons/32x32.png",
  "icons/128x128.png",
  "icons/128x128@2x.png",
  "icons/icon.png"
],
      "copyright": "© 2025 AniXOS",
      "category": "Business",
      "shortDescription": "Plateforme MES de gestion d'atelier",
      "longDescription": "AniXOS — Industrial Shop Floor Execution & Workshop MES Platform",
      "windows": {
        "wix": {
          "language": "fr-FR"
        },
        "nsis": {
          "languages": ["French", "English"],
          "installMode": "perMachine",
          "displayLanguageSelector": true
        }
      },
      "macOS": {
        "minimumSystemVersion": "10.15"
      }
    },
    "plugins": {}
  }